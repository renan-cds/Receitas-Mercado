{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information", "System": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "Database": { "MigrateOnStart": true },
  "DataProtection": { "KeysPath": "data/keys" },
  "Storage": { "Path": "data/files" },
  "ForwardedHeaders": { "Enabled": false },
  "RateLimit": { "AuthPerMinute": 20 },
  "Import": { "TimeoutSeconds": 5, "MaxBytes": 1500000, "MaxRedirects": 2 },
  "Ai": { "AllowPrivateEndpoints": false, "TimeoutSeconds": 45 }
}
